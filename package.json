{
  "name": "universal-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:ui && concurrently -n worker,ui -c blue,magenta \"pnpm dev:worker\" \"pnpm dev:ui\"",
    "dev:worker": "wrangler dev --port 8787",
    "dev:ui": "pnpm --filter universal-agent-ui dev",
    "build:ui": "pnpm --filter universal-agent-ui build",
    "deploy": "pnpm build:ui && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply universal-agent-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply universal-agent-db --remote"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.0",
    "@cloudflare/think": "^0.7.2",
    "agents": "^0.13.2",
    "ai": "^6.0.190",
    "hono": "^4.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260602.1",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.96.0"
  }
}
